# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure values for your environment.
# Never commit .env or actual production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime Configuration
# ------------------------------------------------------------------------------
# Port for the web service (Azure App Service also sets WEBSITES_PORT)
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins (* allows all)
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2. Local Model Artifacts
# ------------------------------------------------------------------------------
# Path to serialized model and TF-IDF vectorizer
MODEL_PATH=models/model.pkl
VECTORIZER_PATH=models/tfidf_vectorizer.pkl

# ------------------------------------------------------------------------------
# 3. Azure Cloud Storage (DVC Remote & Data Ingestion)
# ------------------------------------------------------------------------------
# Retrieve from Azure Portal: Storage Account -> Security + Networking -> Access Keys
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=sentiment-data

# ------------------------------------------------------------------------------
# 4. Experiment Tracking (MLflow & DagsHub)
# ------------------------------------------------------------------------------
# DagsHub Personal Access Token (can also be set via environment variable: sentiment_analysis)
DAGSHUB_TOKEN=
DAGSHUB_REPO_OWNER=rohitkr8527
DAGSHUB_REPO_NAME=sentiment-analysis
MLFLOW_TRACKING_URI=https://dagshub.com/rohitkr8527/sentiment-analysis.mlflow
MLFLOW_EXPERIMENT_NAME=sentiment-analysis-pipeline
MLFLOW_MODEL_NAME=my_model
MLFLOW_MODEL_STAGE=Production

# Set to true to load model directly from remote MLflow Model Registry in FastAPI
USE_MLFLOW_MODEL=false
